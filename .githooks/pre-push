#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
app_name="$(basename "$repo_root")"

search_dir="$repo_root"
etrobo_root=""
while [[ "$search_dir" != "/" ]]; do
	if [[ -d "$search_dir/scripts" && -d "$search_dir/workspace" ]]; then
		etrobo_root="$search_dir"
		break
	fi
	search_dir="$(dirname "$search_dir")"
done

if [[ -z "$etrobo_root" ]]; then
	echo "pre-push: failed to find etrobo root from $repo_root" >&2
	exit 1
fi

printf 'pre-push: building %s in %s\n' "$app_name" "$etrobo_root"

pushd "$etrobo_root" >/dev/null
./make "app=$app_name" sim
popd >/dev/null
